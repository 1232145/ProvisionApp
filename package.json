{
  "name": "provision",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "antd": "^5.20.4",
    "dayjs": "^1.11.13",
    "file-saver": "^2.0.5",
    "moment": "^2.31.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "main": "public/electron.js",
  "homepage": "./",
  "build": {
    "appId": "com.esp.provision",
    "productName": "Provisioning App",
    "icon": "public/logo512.png",
    "extraMetadata": {
      "main": "build/electron.js"
    },
    "files": [
      "build/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis"
    }
  },
  "scripts": {
    "start": "vite",
    "build": "vite build && node copy-electron.js",
    "build:react": "vite build",
    "build:electron": "npm run build && electron-builder --win --x64",
    "build:ios": "npm run build:react && npx cap sync ios",
    "sync:ios": "npx cap sync ios",
    "open:ios": "npx cap open ios",
    "lint": "eslint src public copy-electron.js vite.config.mjs",
    "test": "vitest run",
    "electron": "electron ."
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.0.0",
    "vite": "^8.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "vitest": "^5.0.5"
  },
  "author": "Huy Ngo",
  "license": "ISC",
  "description": "Environmental Studies Data Collection Project"
}
